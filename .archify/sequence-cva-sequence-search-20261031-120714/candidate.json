  "cards": [
    {
      "dot": "cyan",
      "title": "Why search runs in flows",
      "items": [
        "Canvas App delegation limits make distinct values and counts over 40,000 rows impractical in the app",
        "get options, count and search are instant Power Automate flows called from the app",
        "Sector, Industry and Country lists are read directly from Dataverse"
      ]
    },
    {
      "dot": "amber",
      "title": "Submitting the Shortlist",
      "items": [
        "The whole top-50 list is submitted; partial selection isn't possible",
        "Submit is blocked when zero companies match",
        "Searches before submission aren't saved"
      ]
    }
  ]
