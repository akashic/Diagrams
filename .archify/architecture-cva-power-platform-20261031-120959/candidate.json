  "cards": [
    { "dot": "cyan", "title": "Search", "items": ["Instant flows run get options, count and search; Canvas App delegation limits make distinct values and counts over 40,000 rows impractical in the app", "Sector, Industry and Country lists are read directly from Dataverse reference tables", "search returns the top 50 Listed Companies by Market Cap as the Shortlist"] },
    { "dot": "emerald", "title": "Orchestration", "items": ["Parallel Apply to each scores one Shortlist Entry per iteration, with built-in retry; an exhausted entry is marked not scored", "Rows sorted by Match Score, highest first; status moves Submitted → Scoring → Building Report → Sent", "A whole-stage failure sets Failed and emails the User a failure notice"] },
    { "dot": "rose", "title": "Access", "items": ["Users sign in with Microsoft Entra ID work accounts", "Users create and read only their own Valuation Requests and Shortlist Entries", "Flow connections use a service account, so Users never reach Azure OpenAI, SharePoint or Outlook directly"] }
